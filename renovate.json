{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>cinderblock/ops//renovate/app"
  ],
  "packageRules": [
    {
      "description": "A build takes two hours, so updates stay PRs (ops plans/pinned-versions-update-prs.md).",
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": false
    }
  ]
}
